# ── Mode A: Local Keycloak (docker-compose up) ────────────────────────────────
# Run scripts/keycloak-setup.sh to generate the client secret, then fill it in.
#
# AZURE_TENANT_ID=test
# AZURE_CLIENT_ID=simulator-client
# AZURE_CLIENT_SECRET=<paste from keycloak-setup output>
# BACKEND_CLIENT_ID=backend-api
# TOKEN_URL=http://localhost:8180/realms/test/protocol/openid-connect/token
# BACKEND_URL=http://localhost:8080
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# FIREBASE_API_KEY=local-fake-key

# ── Mode B: Real Azure AD app registration ─────────────────────────────────────
# Requirements from your IAM team:
#   - App registration for the SIMULATOR  (client credentials enabled, no redirect URI)
#   - App registration for the BACKEND API (exposes an app role, e.g. Backend.Call)
#   - Simulator app registration granted the Backend.Call role (admin consent done)
#
# AZURE_TENANT_ID=<your-tenant-uuid>          # e.g. 11111111-2222-3333-4444-555555555555
# AZURE_CLIENT_ID=<simulator-app-client-id>   # e.g. aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee
# AZURE_CLIENT_SECRET=<simulator-client-secret>
# BACKEND_CLIENT_ID=<backend-api-client-id-or-app-id-uri>
#   e.g. api://ffffffff-0000-1111-2222-333333333333
#        or just the backend's client UUID
# TOKEN_URL=https://login.microsoftonline.com/<your-tenant-uuid>/oauth2/v2.0/token
# BACKEND_URL=http://localhost:8080
#
# The backend derives its JWKS URL and issuer automatically from AZURE_TENANT_ID:
#   JWKS_URL  → https://login.microsoftonline.com/<tenant>/discovery/v2.0/keys
#   JWT_ISSUER → https://login.microsoftonline.com/<tenant>/v2.0
#
# Override them explicitly if needed:
# JWKS_URL=
# JWT_ISSUER=
